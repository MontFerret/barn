{
  "schemaVersion": 1,
  "id": "montferret/xml",
  "version": "1.0.0-rc.15",
  "namespaces": [
    {
      "name": "XML",
      "functions": [
        {
          "name": "ATTR",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "value",
                  "type": "Object",
                  "description": "XML document, element, or text node."
                },
                {
                  "name": "name",
                  "type": "String",
                  "description": "Attribute name."
                }
              ],
              "description": "Attr returns the named attribute value for an XML element-like node.",
              "return": {
                "type": "String|None",
                "description": "Attribute value or None."
              }
            }
          ]
        },
        {
          "name": "CHILDREN",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "value",
                  "type": "Object",
                  "description": "XML document, element, or text node."
                }
              ],
              "description": "Children returns the child nodes for an XML document or element.",
              "return": {
                "type": "Array\u003cObject\u003e",
                "description": "Child nodes, or an empty array for a text node."
              }
            }
          ]
        },
        {
          "name": "DECODE",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "String|Binary",
                  "description": "XML content."
                }
              ],
              "variadic": true,
              "description": "Decode decodes XML content into a normalized document object.",
              "return": {
                "type": "Object",
                "description": "Normalized XML document."
              }
            }
          ]
        },
        {
          "name": "DECODE_STREAM",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "String|Binary",
                  "description": "XML content."
                }
              ],
              "variadic": true,
              "description": "DecodeStream decodes XML content lazily into normalized XML events.",
              "return": {
                "type": "Iterator\u003cObject\u003e",
                "description": "Iterator over normalized XML events."
              }
            }
          ]
        },
        {
          "name": "ENCODE",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "value",
                  "type": "Object",
                  "description": "Normalized XML document or element."
                }
              ],
              "variadic": true,
              "description": "Encode serializes a normalized XML document or element into XML text.",
              "return": {
                "type": "String",
                "description": "XML text."
              }
            }
          ]
        },
        {
          "name": "ROOT",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "value",
                  "type": "Object",
                  "description": "XML document, element, or text node."
                }
              ],
              "description": "Root returns the root element for a document or the element itself.",
              "return": {
                "type": "Object|None",
                "description": "Root or element node, or None for a text node."
              }
            }
          ]
        },
        {
          "name": "TEXT",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "value",
                  "type": "Object",
                  "description": "XML document, element, or text node."
                }
              ],
              "description": "Text returns the descendant text content for an XML node.",
              "return": {
                "type": "String",
                "description": "Concatenated text content."
              }
            }
          ]
        }
      ]
    }
  ]
}

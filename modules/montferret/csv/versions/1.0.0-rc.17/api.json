{
  "schemaVersion": 1,
  "id": "montferret/csv",
  "version": "1.0.0-rc.17",
  "namespaces": [
    {
      "name": "CSV",
      "functions": [
        {
          "name": "DECODE",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "String",
                  "description": "CSV text."
                },
                {
                  "name": "opts",
                  "type": "Object?",
                  "description": "Decoding options."
                }
              ],
              "variadic": true,
              "description": "Decode decodes CSV text into an array of objects.\nWhen opts.header is true, the first record defines object keys; otherwise\nopts.columns or generated colN names are used.",
              "return": {
                "type": "Array\u003cObject\u003e",
                "description": "Decoded objects."
              }
            }
          ]
        },
        {
          "name": "DECODE_ROWS",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "String",
                  "description": "CSV text."
                },
                {
                  "name": "opts",
                  "type": "Object?",
                  "description": "Decoding options."
                }
              ],
              "variadic": true,
              "description": "DecodeRows decodes CSV text into an array of raw row arrays.\nIt keeps header rows as data and applies decoding options to each field.",
              "return": {
                "type": "Array\u003cArray\u003cAny\u003e\u003e",
                "description": "Decoded row arrays."
              }
            }
          ]
        },
        {
          "name": "DECODE_ROWS_STREAM",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "String|Binary",
                  "description": "CSV content."
                },
                {
                  "name": "opts",
                  "type": "Object?",
                  "description": "Decoding options."
                }
              ],
              "variadic": true,
              "description": "DecodeRowsStream decodes CSV content from string or binary input.\nIt returns an iterator value over row arrays keyed by the original CSV\nrecord number after parsing.",
              "return": {
                "type": "Iterator\u003cArray\u003cAny\u003e\u003e",
                "description": "Iterator over decoded row arrays."
              }
            }
          ]
        },
        {
          "name": "DECODE_STREAM",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "String|Binary",
                  "description": "CSV content."
                },
                {
                  "name": "opts",
                  "type": "Object?",
                  "description": "Decoding options."
                }
              ],
              "variadic": true,
              "description": "DecodeStream decodes CSV content from string or binary input.\nIt returns an iterator value over objects keyed by the original CSV\nrecord number after parsing.",
              "return": {
                "type": "Iterator\u003cObject\u003e",
                "description": "Iterator over decoded objects."
              }
            }
          ]
        },
        {
          "name": "ENCODE",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "data",
                  "type": "Array\u003cAny\u003e",
                  "description": "Objects or row arrays to encode."
                },
                {
                  "name": "opts",
                  "type": "Object?",
                  "description": "Encoding options."
                }
              ],
              "variadic": true,
              "description": "Encode encodes an array of objects or row arrays into CSV text.\nObject input can emit a header row depending on opts.header and opts.columns.",
              "return": {
                "type": "String",
                "description": "CSV text."
              }
            }
          ]
        }
      ]
    }
  ]
}
